  ]
 },
 "commander_role": {
  "value": {
   "level": "central",
   "advances_plan": "Every copy, reanimation and mill-doubler exists to multiply Xander's three triggers, and his attack is half of two Spellbook infinites.",
   "honest_note": "Seven mana, so the deck relies on reanimation and clones to make him realistic. Halving rounds down, so an odd library leaves one card (M1 xander-05). Guildmage + Mindcrank, Monument/Bruvac + Cacophony, Sword + Assault and Breach all win without him."
  },
  "evidence_class": "strategic_judgment",
