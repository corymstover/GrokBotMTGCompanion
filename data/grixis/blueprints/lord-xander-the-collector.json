 "plan": {
  "value": {
   "primary": "Xander trigger multiplication: reanimate or cheat out a seven-mana commander (Entomb + Reanimate/Animate Dead/Persist/Feign Death), copy him (Phantasmal Image, Spark Double, Sakashima, Blade of Selves, Helm of the Host, Hall of Echoes, Auton Soldier) and stack his discard-half, mill-half and sacrifice-half triggers.",
   "secondary": "Finish the mill with Bruvac, Riverchurn Monument, Fraying Sanity or Maddening Cacophony; compact backups are Duskmantle Guildmage + Mindcrank, Sword of Feast and Famine + Aggravated Assault, and Breach lines."
  },
  "evidence_class": "strategic_judgment",
  "confidence": "high",
  "evidence": [
