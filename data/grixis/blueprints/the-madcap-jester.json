  ]
 },
 "plan": {
  "value": {
   "primary": "Exile theft into compact Grixis wins: library-exile effects (Extract, Tasha's Hideous Laughter, Ashiok, Jester's Cap) become tutors and card draw under the Jester's play permission, protected by free counters, and the deck closes with Thassa's Oracle + Demonic Consultation / Tainted Pact or Underworld Breach + Brain Freeze.",
   "secondary": "Cast-from-exile payoffs (Dragon's Smile, Prosper, Gonti, Laughing Jasper Flint) and the Jester's attack trigger (hasty with Greaves) for incremental stolen resources."
  },
  "evidence_class": "strategic_judgment",
  "confidence": "high",
