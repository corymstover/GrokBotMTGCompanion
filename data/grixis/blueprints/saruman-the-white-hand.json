  ]
 },
 "plan": {
  "value": {
   "primary": "Spellslinger amass: each noncreature spell amasses Orcs equal to its mana value. Cost reducers, delve, alternate and free costs don't lower mana value, so cheap high-MV spells (Blasphemous Act, Dig Through Time, Blood for the Blood God!, Volcanic Salvo, Treasure Cruise, free spells) grow a huge Orc Army.",
   "secondary": "Trigger multipliers (Harmonic Prodigy, Wizard's Staff, Veyran), Mauhúr and The Ozolith, and payoffs that turn the Army or its counters into damage (The Great Goblin, Soul's Fire, Chandra's Ignition, Widespread Brutality, Fall of Cair Andros)."
  },
  "evidence_class": "strategic_judgment",
  "confidence": "high",
  "evidence": [
