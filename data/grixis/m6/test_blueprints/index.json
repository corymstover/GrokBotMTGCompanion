  "priority_policy": {
    "P0": "Source Oracle ability, top three interaction rules, first failure red team (plus a commander for partner if applicable)",
    "P1": "Other key interactions, documented engine loops, finish conditions and secondary failure modes",
    "run_order": [
      "reconcile current canonical 100 and Oracle, with documented project exceptions",
      "reuse existing generic foundation suites and any already proven family adapter",
      "implement and execute P0 cases with real physical source payment, trigger/priority and negative witnesses",
      "only implement remaining P1 cases if material to candidate conclusion or risk",
      "record checked evidence and owner judgment before M6 certification; no automatic swap"
    ]
  },
