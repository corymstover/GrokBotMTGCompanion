{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/corymstover/GrokBotMTGCompanion/data/grixis/schemas/graph.schema.json",
 "title": "Per-deck dependency graph (v1, generated in M4 by scripts/grixis_graph.py)",
 "type": "object",
 "properties": {
  "schema_version": {
   "const": 1
  },
  "deck_id": {
   "$ref": "common.schema.json#/$defs/deck_id"
  },
  "list_hash": {
   "$ref": "common.schema.json#/$defs/list_hash"
  },
  "blueprint_version": {
   "type": "integer"
  },
  "generated_from": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "nodes": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^(card|commander|package|engine|win|combo|role|interaction):"
     },
     "kind": {
      "enum": [
       "card",
       "commander",
       "package",
       "engine",
       "win",
       "combo",
       "role",
       "interaction"
      ]
     },
     "roles": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "required": [
     "id",
     "kind"
    ],
    "additionalProperties": true
   }
  },
  "edges": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "from": {
      "type": "string"
     },
     "to": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "piece_of",
       "enables",
       "tutors_for",
       "protects",
       "recurs",
       "fuels",
       "payoff_of",
       "fixes",
       "redundant_with",
       "member_of"
      ]
     },
     "evidence": {
      "type": "array",
      "items": {
       "$ref": "common.schema.json#/$defs/evidence_ref"
      },
      "minItems": 1
     },
     "evidence_class": {
      "$ref": "common.schema.json#/$defs/evidence_class"
     },
     "layer": {
      "enum": [
       "spellbook",
       "blueprint",
       "role",
       "m1_edges",
       "m1_review"
      ]
     }
    },
    "required": [
     "from",
     "to",
     "kind",
     "evidence",
     "evidence_class",
     "layer"
    ],
    "additionalProperties": true
   }
  },
  "metrics": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "structural_necessity": {
      "enum": [
       "necessary",
       "important",
       "redundant",
       "independent"
      ]
     },
     "breaks_if_removed": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "redundancy": {
      "type": "integer"
     },
     "best_alternative_in_role": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "structural_necessity",
     "breaks_if_removed",
     "redundancy",
     "best_alternative_in_role"
    ],
    "additionalProperties": true
   }
  },
  "annotations": {
   "type": "array",
   "description": "M1 review-layer relations with graph_kind null (pair edges: combo_with / interacts_with / conflicts_with), kept as annotations (Bot cycle 59.1).",
   "items": {
    "type": "object",
    "properties": {
     "from": {
      "type": "string"
     },
     "to": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "combo_with",
       "interacts_with",
       "conflicts_with"
      ]
     },
     "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
       "$ref": "common.schema.json#/$defs/evidence_ref"
      }
     },
     "evidence_class": {
      "$ref": "common.schema.json#/$defs/evidence_class"
     }
    },
    "required": [
     "from",
     "to",
     "kind",
     "evidence",
     "evidence_class"
    ],
    "additionalProperties": true
   }
  },
  "m1": {
   "type": "object",
   "properties": {
    "status": {
     "enum": [
      "ingested",
      "absent",
      "invalid",
      "stale_list",
      "stale_review"
     ]
    }
   },
   "required": [
    "status"
   ],
   "additionalProperties": true
  },
  "snapshot": {
   "type": "object",
   "properties": {
    "id": {
     "$ref": "common.schema.json#/$defs/sha256"
    },
    "inputs": {
     "type": "object"
    }
   },
   "required": [
    "id",
    "inputs"
   ],
   "additionalProperties": false
  },
  "slug": {
   "$ref": "common.schema.json#/$defs/slug"
  },
  "generated_by": {
   "type": "string"
  },
  "rule_version": {
   "const": "graph-v1"
  },
  "cycle": {
   "type": "integer"
  },
  "necessity_rules": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "warnings": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "counts": {
   "type": "object"
  }
 },
 "required": [
  "schema_version",
  "deck_id",
  "list_hash",
  "blueprint_version",
  "generated_from",
  "nodes",
  "edges",
  "metrics",
  "m1",
  "snapshot"
 ],
 "additionalProperties": false
}
