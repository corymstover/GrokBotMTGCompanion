{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/corymstover/GrokBotMTGCompanion/data/grixis/schemas/graph.schema.json",
 "title": "Per-deck dependency graph (v1 draft, generated in M4)",
 "type": "object",
 "properties": {
  "schema_version": {
   "const": 1
  },
  "deck_id": {
   "$ref": "common.schema.json#/$defs/deck_id"
  },
  "list_hash": {
   "$ref": "common.schema.json#/$defs/list_hash"
  },
  "blueprint_version": {
   "type": "integer"
  },
  "generated_from": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "nodes": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^(card|commander|package|engine|win|combo|role):"
     },
     "kind": {
      "enum": [
       "card",
       "commander",
       "package",
       "engine",
       "win",
       "combo",
       "role"
      ]
     },
     "roles": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "required": [
     "id",
     "kind"
    ],
    "additionalProperties": true
   }
  },
  "edges": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "from": {
      "type": "string"
     },
     "to": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "piece_of",
       "enables",
       "tutors_for",
       "protects",
       "recurs",
       "fuels",
       "payoff_of",
       "fixes",
       "redundant_with",
       "member_of"
      ]
     },
     "evidence": {
      "type": "array",
      "items": {
       "$ref": "common.schema.json#/$defs/evidence_ref"
      },
      "minItems": 1
     }
    },
    "required": [
     "from",
     "to",
     "kind",
     "evidence"
    ],
    "additionalProperties": true
   }
  },
  "metrics": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "structural_necessity": {
      "enum": [
       "necessary",
       "important",
       "redundant",
       "independent"
      ]
     },
     "breaks_if_removed": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "redundancy": {
      "type": "integer"
     },
     "best_alternative_in_role": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "structural_necessity",
     "breaks_if_removed",
     "redundancy",
     "best_alternative_in_role"
    ],
    "additionalProperties": true
   }
  }
 },
 "required": [
  "schema_version",
  "deck_id",
  "list_hash",
  "blueprint_version",
  "generated_from",
  "nodes",
  "edges",
  "metrics"
 ],
 "additionalProperties": false
}
