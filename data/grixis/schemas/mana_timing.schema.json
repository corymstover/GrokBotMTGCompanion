{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/corymstover/GrokBotMTGCompanion/blob/main/data/grixis/schemas/mana_timing.schema.json",
  "title": "Grixis Step C mana timing and source reliability v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","deck_id","slug","canonical_hash","status","evidence_class","confidence","authority","inputs","source_categories","strict_land_sources","mdfc_optional_sources","fetch_validation","stranded_fetches","turn_readiness","commander_colored_readiness","limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "deck_id": {"type":"string","minLength":1},
    "slug": {"type":"string","minLength":1},
    "canonical_hash": {"type":"string","pattern":"^lh1:"},
    "status": {"const":"provisional_evidence"},
    "evidence_class": {"const":"derived_metric"},
    "confidence": {"enum":["moderate","low"]},
    "authority": {"type":"object","additionalProperties":false,"required":["can_decide","note"],"properties":{"can_decide":{"const":false},"note":{"type":"string","minLength":1}}},
    "inputs": {"type":"object","additionalProperties":false,"required":["mana_baseline","canonical_export","frozen_card_pages"],"properties":{"mana_baseline":{"type":"string"},"canonical_export":{"type":"string"},"frozen_card_pages":{"type":"string"}}},
    "source_categories": {"type":"object","additionalProperties":{"type":"integer","minimum":0}},
    "strict_land_sources": {"type":"array","items":{"$ref":"#/$defs/source"}},
    "mdfc_optional_sources": {"type":"array","items":{"$ref":"#/$defs/source"}},
    "fetch_validation": {"type":"array","items":{"$ref":"#/$defs/fetch"}},
    "stranded_fetches": {"$ref":"#/$defs/str_array"},
    "turn_readiness": {"type":"object","additionalProperties":false,"required":["2","3","4","5"],"properties":{"2":{"$ref":"#/$defs/turn"},"3":{"$ref":"#/$defs/turn"},"4":{"$ref":"#/$defs/turn"},"5":{"$ref":"#/$defs/turn"}}},
    "commander_colored_readiness": {"type":"array","minItems":1,"maxItems":2,"items":{"type":"object","additionalProperties":false,"required":["name","colored_requirements","cards_seen_by_base_resource_turn","potential_distinct_source_match","unconditional_distinct_source_match","untapped_capable_distinct_source_match","note"],"properties":{"name":{"type":"string"},"colored_requirements":{"type":"object","propertyNames":{"enum":["U","B","R"]},"additionalProperties":{"type":"integer","minimum":1}},"cards_seen_by_base_resource_turn":{"type":"integer","minimum":0},"potential_distinct_source_match":{"$ref":"#/$defs/probability"},"unconditional_distinct_source_match":{"$ref":"#/$defs/probability"},"untapped_capable_distinct_source_match":{"$ref":"#/$defs/probability"},"note":{"type":"string"}}}},
    "limitations": {"type":"array","minItems":6,"items":{"type":"string","minLength":1}}
  },
  "$defs": {
    "probability": {"type":"number","minimum":0,"maximum":1},
    "str_array": {"type":"array","items":{"type":"string"}},
    "mask": {"type":"string","pattern":"^(|U|B|R|UB|UR|BR|UBR)$"},
    "source": {"type":"object","additionalProperties":false,"required":["card","kind","potential_colors","unconditional_colors","untapped_capable_colors","guaranteed_untapped_colors","entry_timing","conditional_mana_ability","fetch_target_count"],"properties":{"card":{"type":"string"},"kind":{"enum":["fetch","direct_land","mdfc_land_face"]},"potential_colors":{"$ref":"#/$defs/mask"},"unconditional_colors":{"$ref":"#/$defs/mask"},"untapped_capable_colors":{"$ref":"#/$defs/mask"},"guaranteed_untapped_colors":{"$ref":"#/$defs/mask"},"entry_timing":{"enum":["always_tapped","conditional_untapped","untapped_by_default"]},"conditional_mana_ability":{"type":"boolean"},"fetch_target_count":{"type":"integer","minimum":0}}},
    "target": {"type":"object","additionalProperties":false,"required":["card","basic_types","direct_colors","entry_timing"],"properties":{"card":{"type":"string"},"basic_types":{"type":"array","items":{"enum":["Plains","Island","Swamp","Mountain","Forest"]}},"direct_colors":{"$ref":"#/$defs/mask"},"entry_timing":{"enum":["always_tapped","conditional_untapped","untapped_by_default"]}}},
    "targets_by_color": {"type":"object","additionalProperties":false,"required":["U","B","R"],"properties":{"U":{"$ref":"#/$defs/str_array"},"B":{"$ref":"#/$defs/str_array"},"R":{"$ref":"#/$defs/str_array"}}},
    "fetch": {"type":"object","additionalProperties":false,"required":["card","search_types","basic_only","target_count","actual_target_colors","untapped_capable_target_colors","targets_by_color","untapped_capable_targets_by_color","targets"],"properties":{"card":{"type":"string"},"search_types":{"type":"array","items":{"enum":["Plains","Island","Swamp","Mountain","Forest"]}},"basic_only":{"type":"boolean"},"target_count":{"type":"integer","minimum":0},"actual_target_colors":{"$ref":"#/$defs/mask"},"untapped_capable_target_colors":{"$ref":"#/$defs/mask"},"targets_by_color":{"$ref":"#/$defs/targets_by_color"},"untapped_capable_targets_by_color":{"$ref":"#/$defs/targets_by_color"},"targets":{"type":"array","items":{"$ref":"#/$defs/target"}}}},
    "turn": {"type":"object","additionalProperties":false,"required":["cards_seen_no_mulligan","potential_distinct_source_match_UBR","unconditional_distinct_source_match_UBR","untapped_capable_distinct_source_match_UBR","flex_land_potential_distinct_source_match_UBR","strict_land_drop_probability","flex_land_drop_probability"],"properties":{"cards_seen_no_mulligan":{"type":"integer","minimum":0},"potential_distinct_source_match_UBR":{"$ref":"#/$defs/probability"},"unconditional_distinct_source_match_UBR":{"$ref":"#/$defs/probability"},"untapped_capable_distinct_source_match_UBR":{"$ref":"#/$defs/probability"},"flex_land_potential_distinct_source_match_UBR":{"$ref":"#/$defs/probability"},"strict_land_drop_probability":{"$ref":"#/$defs/probability"},"flex_land_drop_probability":{"$ref":"#/$defs/probability"}}}
  }
}
