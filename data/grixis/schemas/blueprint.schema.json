{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/corymstover/GrokBotMTGCompanion/data/grixis/schemas/blueprint.schema.json",
 "title": "Commander Blueprint v2 (Bot cycle 50, M2)",
 "description": "Machine-readable commander blueprint (brief §3). Every field is a claim with evidence_class, confidence and at least one evidence ref (Cory constraint: evidence on every field). Oracle text is fact; plans and ceilings are strategic_judgment; EDHREC data is derived_metric or heuristic; regex hooks are supporting features only (heuristic), never identity. Checked by scripts/grixis_blueprints.py --check.",
 "type": "object",
 "properties": {
  "schema_version": {
   "const": 2
  },
  "deck_id": {
   "$ref": "common.schema.json#/$defs/deck_id"
  },
  "slug": {
   "type": "string"
  },
  "version": {
   "type": "integer",
   "minimum": 1
  },
  "status": {
   "enum": [
    "draft",
    "seeded",
    "cory_reviewed"
   ],
   "description": "seeded = written by GrokBot from evidence; cory_reviewed only via Cory (reviewed_by)."
  },
  "cycle": {
   "type": "integer"
  },
  "date": {
   "$ref": "common.schema.json#/$defs/date"
  },
  "canonical_hash": {
   "$ref": "common.schema.json#/$defs/list_hash"
  },
  "commanders": {
   "type": "object",
   "properties": {
    "value": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "properties": {
       "name": {
        "type": "string"
       },
       "oracle_id": {
        "type": "string"
       },
       "oracle_text": {
        "type": "string"
       },
       "oracle_sha256": {
        "$ref": "common.schema.json#/$defs/sha256"
       },
       "type_line": {
        "type": "string"
       }
      },
      "required": [
       "name",
       "oracle_id",
       "oracle_text",
       "oracle_sha256",
       "type_line"
      ],
      "additionalProperties": false
     }
    },
    "evidence_class": {
     "$ref": "common.schema.json#/$defs/evidence_class"
    },
    "confidence": {
     "$ref": "common.schema.json#/$defs/confidence"
    },
    "evidence": {
     "type": "array",
     "items": {
      "$ref": "common.schema.json#/$defs/evidence_ref"
     },
     "minItems": 1
    }
   },
   "required": [
    "value",
    "evidence_class",
    "confidence",
    "evidence"
   ],
   "additionalProperties": false
  },
  "plan": {
   "type": "object",
   "properties": {
    "value": {
     "type": "object",
     "properties": {
      "primary": {
       "type": "string"
      },
      "secondary": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "primary",
      "secondary"
     ],
     "additionalProperties": false
    },
    "evidence_class": {
     "$ref": "common.schema.json#/$defs/evidence_class"
    },
    "confidence": {
     "$ref": "common.schema.json#/$defs/confidence"
    },
    "evidence": {
     "type": "array",
     "items": {
      "$ref": "common.schema.json#/$defs/evidence_ref"
     },
     "minItems": 1
    }
   },
   "required": [
    "value",
    "evidence_class",
    "confidence",
    "evidence"
   ],
   "additionalProperties": false
  },
  "commander_role": {
   "type": "object",
   "properties": {
    "value": {
     "type": "object",
     "properties": {
      "level": {
       "enum": [
        "central",
        "significant",
        "supporting",
        "incidental"
       ]
      },
      "advances_plan": {
       "type": "string"
      },
      "honest_note": {
