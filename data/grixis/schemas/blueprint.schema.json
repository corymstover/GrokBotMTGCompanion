    "evidence_class": {
     "$ref": "common.schema.json#/$defs/evidence_class"
    },
    "confidence": {
     "$ref": "common.schema.json#/$defs/confidence"
    },
    "evidence": {
     "type": "array",
     "items": {
      "$ref": "common.schema.json#/$defs/evidence_ref"
     },
     "minItems": 1
    }
   },
   "required": [
    "value",
    "evidence_class",
    "confidence",
    "evidence"
   ],
   "additionalProperties": false,
   "description": "How much the commander itself drives the deck. 'supporting'/'incidental' is said plainly when true (e.g. a cEDH shell around a weak commander)."
  },
  "win_conditions": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "natural",
       "alternate",
       "combo"
