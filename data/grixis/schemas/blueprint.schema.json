     },
     "cards": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "enablers": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "evidence_class": {
      "$ref": "common.schema.json#/$defs/evidence_class"
     },
     "confidence": {
      "$ref": "common.schema.json#/$defs/confidence"
     },
     "evidence": {
      "type": "array",
      "items": {
       "$ref": "common.schema.json#/$defs/evidence_ref"
      },
      "minItems": 1
     }
    },
    "required": [
     "id",
     "kind",
     "description",
     "cards",
     "enablers",
     "evidence_class",
     "confidence",
     "evidence"
    ],
    "additionalProperties": false
   }
  },
  "engines": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "cards": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "online_condition": {
      "type": "string"
     },
