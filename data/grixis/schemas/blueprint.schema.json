      "$ref": "common.schema.json#/$defs/evidence_class"
     },
     "confidence": {
      "$ref": "common.schema.json#/$defs/confidence"
     },
     "evidence": {
      "type": "array",
      "items": {
       "$ref": "common.schema.json#/$defs/evidence_ref"
      },
      "minItems": 1
     }
    },
    "required": [
     "id",
     "description",
     "mitigations",
     "evidence_class",
     "confidence",
     "evidence"
    ],
    "additionalProperties": false
   }
