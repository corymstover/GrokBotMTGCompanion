{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://github.com/corymstover/GrokBotMTGCompanion/data/grixis/schemas/bracket_red_team.schema.json",
 "title":"Step F bracket-specific red-team review packet",
 "type":"object",
 "required":["schema_version","deck_id","slug","canonical_hash","suite_family","bracket","status","evidence_class","authority","source_packet","reviews","packet_context","limitations"],
 "properties":{
  "schema_version":{"const":1},"deck_id":{"type":"string"},"slug":{"type":"string"},"canonical_hash":{"type":"string","pattern":"^lh1:"},
  "suite_family":{"enum":["B5_competitive","B4_resilience"]},"bracket":{"type":"object"},"status":{"const":"red_team_pending"},"evidence_class":{"const":"strategic_judgment"},
  "authority":{"type":"object","required":["can_decide","note"],"properties":{"can_decide":{"const":false},"note":{"type":"string"}},"additionalProperties":false},
  "source_packet":{"type":"string"},
  "reviews":{"type":"array","minItems":1,"items":{"type":"object","required":["id","priority_weight","question","adversarial_challenge","evidence_context","review_contract","review_status","reviewer","analysis","verdict","uncertainties","can_decide"],"properties":{"id":{"type":"string"},"priority_weight":{"type":"number","exclusiveMinimum":0,"maximum":1},"question":{"type":"string"},"adversarial_challenge":{"type":"string"},"evidence_context":{"type":"object"},"review_contract":{"type":"object","required":["required_review_method","acceptable_evidence_classes","heuristic_only_sufficient","must_address_commander_identity","must_address_bracket_context","may_decide_swap"]},"review_status":{"const":"pending"},"reviewer":{"const":null},"analysis":{"const":null},"verdict":{"const":null},"uncertainties":{"type":"array"},"can_decide":{"const":false}},"additionalProperties":false}},
  "packet_context":{"type":"object","required":["failure_modes","audit_slots","commander_role"]},
  "limitations":{"type":"array","minItems":4,"items":{"type":"string"}}
 },
 "additionalProperties":false
}
