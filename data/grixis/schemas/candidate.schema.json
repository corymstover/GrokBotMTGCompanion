{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/corymstover/GrokBotMTGCompanion/data/grixis/schemas/candidate.schema.json",
 "title": "Candidate record with escalation (v1 draft)",
 "description": "The 15–40 full-review range is a default workload, not a gate. Escalated candidates get full review regardless of rank (Cory constraint 3). Bot cycle 60 (M5): optional `sources`, `screening` and `review` (full review against blueprint, role model, graph and best incumbent; swap and goldfish refs).",
 "type": "object",
 "properties": {
  "schema_version": {
   "const": 1
  },
  "deck_id": {
   "$ref": "common.schema.json#/$defs/deck_id"
  },
  "card": {
   "type": "string"
  },
  "oracle_id": {
   "type": "string"
  },
  "rank": {
   "type": [
    "integer",
    "null"
   ]
  },
  "tier": {
   "enum": [
    "A",
    "B",
    "C"
   ]
  },
  "full_review": {
   "type": "boolean"
  },
  "escalation": {
   "type": "object",
   "properties": {
    "escalated": {
     "type": "boolean"
    },
    "reasons": {
     "type": "array",
     "items": {
      "enum": [
       "dependency_analysis",
       "new_card",
       "unusual_oracle_interaction",
       "package_gap",
       "reviewer_evidence",
       "rank_miss_suspected"
      ]
     }
    },
    "evidence_refs": {
     "type": "array",
     "items": {
      "$ref": "common.schema.json#/$defs/evidence_ref"
     }
    },
    "by": {
     "type": [
      "string",
      "null"
     ]
    },
    "note": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "escalated",
    "reasons",
    "evidence_refs",
    "by",
    "note"
   ],
   "additionalProperties": false
  },
  "evidence": {
   "type": "array",
   "items": {
    "$ref": "common.schema.json#/$defs/evidence_ref"
   }
  },
  "workload": {
   "type": "object",
   "properties": {
    "default_full_review_range": {
     "const": [
      15,
      40
     ]
    },
    "is_gate": {
     "const": false
    }
   },
   "required": [
    "default_full_review_range",
    "is_gate"
   ],
   "additionalProperties": false
  },
  "sources": {
   "type": "array",
   "items": {
    "enum": [
     "edhrec",
     "spellbook",
     "blueprint",
     "oracle_hook",
     "package",
     "new_card",
     "rank_fill"
    ]
   }
  },
  "screening": {
   "type": "object",
   "properties": {
    "score": {
     "type": "number"
    },
    "parts": {
     "type": "object",
     "additionalProperties": {
      "type": "number"
     }
    },
    "facts": {
     "type": "object"
    }
   },
   "required": [
    "score",
    "parts",
    "facts"
   ],
   "additionalProperties": false
  },
  "review": {
   "type": "object",
   "properties": {
    "role": {},
    "blueprint": {},
    "graph": {},
    "best_incumbent": {},
    "cut": {
     "type": [
      "string",
      "null"
     ]
    },
    "assessment": {
     "type": "string",
     "minLength": 1
    },
    "evidence_classes": {},
    "decision_support": {
     "type": "object",
     "properties": {
      "ok": {
       "type": "boolean"
      },
      "why_not": {
       "type": "array"
      }
     },
     "required": [
      "ok",
      "why_not"
     ]
    },
    "swap": {
     "type": "string",
     "pattern": "^swap:"
    },
    "goldfish": {},
    "tournament": {
     "type": "object",
     "properties": {
      "window": {
       "type": "string"
      },
      "retrieved": {
       "type": "string"
      },
      "commander_entries": {
       "type": "integer"
      }
     },
     "required": [
      "window",
      "retrieved",
      "commander_entries",
      "card",
      "cut"
     ]
    },
    "matches_registered_challenger": {
     "type": "string"
    }
   },
   "required": [
    "role",
    "blueprint",
    "graph",
    "best_incumbent",
    "cut",
    "assessment",
    "evidence_classes",
    "decision_support"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "schema_version",
  "deck_id",
  "card",
  "oracle_id",
  "rank",
  "tier",
  "full_review",
  "escalation",
  "evidence",
  "workload"
 ],
 "additionalProperties": false
}
