{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/corymstover/GrokBotMTGCompanion/data/grixis/schemas/common.schema.json",
 "title": "Grixis authority: shared definitions (v1)",
 "$defs": {
  "date": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "date_or_null": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "sha256": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$"
  },
  "list_hash": {
   "type": "string",
   "pattern": "^lh1:[0-9a-f]{64}$"
  },
  "list_hash_or_null": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^lh1:[0-9a-f]{64}$"
  },
  "deck_id": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_]+$"
  },
  "slug": {
   "type": "string",
   "pattern": "^[a-z0-9-]+$"
  },
  "state": {
   "enum": [
    "SOURCE_BASELINE",
    "UNDER_REVIEW",
    "CHALLENGER",
    "TESTING",
    "REVIEW_REQUIRED",
    "APPROVAL_READY",
    "APPROVED",
    "CANONICAL_LOCKED",
    "REOPEN_REQUIRED",
    "PENDING_RELEASE"
   ]
  },
  "state_or_null": {
   "enum": [
    "SOURCE_BASELINE",
    "UNDER_REVIEW",
    "CHALLENGER",
    "TESTING",
    "REVIEW_REQUIRED",
    "APPROVAL_READY",
    "APPROVED",
    "CANONICAL_LOCKED",
    "REOPEN_REQUIRED",
    "PENDING_RELEASE",
    null
   ]
  },
  "evidence_class": {
   "enum": [
    "fact",
    "derived_metric",
    "heuristic",
    "hypothesis",
    "test_result",
    "strategic_judgment",
    "approved_decision"
   ]
  },
  "confidence": {
   "enum": [
    "verified",
    "high",
    "moderate",
    "low",
    "test_required",
    "blocked"
   ]
  },
  "evidence_ref": {
   "type": "string",
   "pattern": "^[a-z_]+:.+"
  },
  "official_legality": {
   "enum": [
    "legal",
    "banned",
    "banned_as_companion",
    "not_legal",
    "not_legal_until_release"
   ]
  },
  "project_authorization": {
   "enum": [
    "AUTHORIZED_EXCEPTION",
    "AUTHORIZED_FUTURE_RELEASE",
    "NOT_REQUIRED",
    "UNAUTHORIZED"
   ]
  },
  "bracket": {
   "enum": [
    "1",
    "2",
    "3",
    "4",
    "5",
    "cEDH",
    null
   ]
  },
  "human_id": {
   "type": "string",
   "pattern": "^[a-z0-9-]+$"
  }
 }
}
