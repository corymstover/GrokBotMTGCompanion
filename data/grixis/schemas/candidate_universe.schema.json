{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/corymstover/GrokBotMTGCompanion/data/grixis/schemas/candidate_universe.schema.json",
 "title": "M5 per-deck candidate universe, triage, full reviews, swap hypotheses and paired tests (v1)",
 "description": "Bot cycle 60. `candidates` items are candidate.schema.json records, `swaps` swap.schema.json, `tests` test.schema.json (validated separately by scripts/grixis_candidates.py --check). Provisional and exploratory: nothing here changes a list or registers a challenger.",
 "type": "object",
 "properties": {
  "schema_version": {
   "const": 1
  },
  "deck_id": {
   "$ref": "common.schema.json#/$defs/deck_id"
  },
  "slug": {
   "type": "string"
  },
  "generated_by": {
   "type": "string"
  },
  "cycle": {
   "type": "integer"
  },
  "list_hash": {
   "$ref": "common.schema.json#/$defs/list_hash"
  },
  "pass_id": {
   "type": "string",
   "pattern": "^m5:"
  },
  "snapshot": {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "date": {
     "type": "string"
    }
   },
   "required": [
    "id",
    "graph",
    "evidence",
    "audit",
    "oracle_bulk",
    "default_bulk",
    "spellbook_almost",
    "edhrec_pages",
    "simulator",
    "date"
   ]
  },
  "authority": {
   "type": "object",
   "properties": {
    "status": {
     "const": "provisional"
    },
    "exploratory": {
     "const": true
    }
   },
   "required": [
    "status",
    "exploratory",
    "note"
   ]
  },
  "universe": {
   "type": "object",
   "properties": {
    "size": {
     "type": "integer",
     "minimum": 200,
     "maximum": 500
    },
    "bounds": {
     "const": [
      200,
      500
     ]
    }
   },
   "required": [
    "definition",
    "bounds",
    "sources",
    "size",
    "sources_kept",
    "excluded",
    "screen_rules",
    "not_legal_watchlist"
   ]
  },
  "triage": {
   "type": "object",
   "properties": {
    "default_full_reviews": {
     "type": "integer",
     "minimum": 15,
     "maximum": 40
    },
    "workload_is_gate": {
     "const": false
    }
   },
   "required": [
    "default_full_reviews",
    "default_rule",
    "escalated",
    "escalation_reasons",
    "escalation_rules",
    "escalation_overflow",
    "full_reviews",
    "workload_is_gate"
   ]
  },
  "counts": {
   "type": "object"
  },
  "tournament": {
   "type": "object",
   "properties": {
    "applicable": {
     "type": "boolean"
    }
   },
   "required": [
    "applicable",
    "estimated_ceiling"
   ]
  },
  "candidates": {
   "type": "array"
  },
  "swaps": {
   "type": "array"
  },
  "tests": {
   "type": "array"
  },
  "test_common": {
   "type": "object",
   "required": [
    "simulator",
    "samples",
    "seed",
    "prereg",
    "limitations",
    "method"
   ]
  }
 },
 "required": [
  "schema_version",
  "deck_id",
  "slug",
  "generated_by",
  "cycle",
  "list_hash",
  "pass_id",
  "snapshot",
  "authority",
  "universe",
  "triage",
  "counts",
  "tournament",
  "candidates",
  "swaps",
  "tests",
  "test_common"
 ],
 "additionalProperties": false
}
