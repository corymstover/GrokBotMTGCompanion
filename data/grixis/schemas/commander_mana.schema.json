{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/corymstover/GrokBotMTGCompanion/blob/main/data/grixis/schemas/commander_mana.schema.json",
  "title":"Grixis Step C commander-casting and tax-recovery evidence v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","deck_id","slug","canonical_hash","status","evidence_class","confidence","authority","method","commanders","limitations"],
  "properties":{
    "schema_version":{"const":1},"deck_id":{"type":"string"},"slug":{"type":"string"},"canonical_hash":{"type":"string","pattern":"^lh1:"},
    "status":{"const":"provisional_test_evidence"},"evidence_class":{"const":"test_result"},"confidence":{"enum":["moderate","low"]},
    "authority":{"type":"object","additionalProperties":false,"required":["can_decide","note"],"properties":{"can_decide":{"const":false},"note":{"type":"string"}}},
    "method":{"type":"object","additionalProperties":false,"required":["simulator","model","simulator_sha256","samples","seed","turns","pairing","commander_pair_policy"],"properties":{"simulator":{"const":"grixis_sim"},"model":{"const":"1.1"},"simulator_sha256":{"type":"string","pattern":"^sha256:"},"samples":{"type":"integer","minimum":100},"seed":{"type":"integer"},"turns":{"type":"integer","minimum":6},"pairing":{"type":"string"},"commander_pair_policy":{"type":"string"}}},
    "commanders":{"type":"array","minItems":1,"maxItems":2,"items":{"$ref":"#/$defs/commander"}},
    "limitations":{"type":"array","minItems":6,"items":{"type":"string","minLength":1}}
  },
  "$defs":{
    "prob":{"type":"number","minimum":0,"maximum":1},
    "probturn":{"type":"object","additionalProperties":false,"required":["2","3","4","5","6","8","10"],"properties":{"2":{"$ref":"#/$defs/prob"},"3":{"$ref":"#/$defs/prob"},"4":{"$ref":"#/$defs/prob"},"5":{"$ref":"#/$defs/prob"},"6":{"$ref":"#/$defs/prob"},"8":{"$ref":"#/$defs/prob"},"10":{"$ref":"#/$defs/prob"}}},
    "curve":{"type":"array","minItems":10,"maxItems":10,"items":{"type":"number","minimum":0}},
    "castsummary":{"type":"object","additionalProperties":false,"required":["cast_by_turn","mean_turn_when_cast","cast_share_by_turn10","mana_available_by_turn","mana_spent_by_turn"],"properties":{"cast_by_turn":{"$ref":"#/$defs/probturn"},"mean_turn_when_cast":{"type":["number","null"],"minimum":1,"maximum":10},"cast_share_by_turn10":{"$ref":"#/$defs/prob"},"mana_available_by_turn":{"$ref":"#/$defs/curve"},"mana_spent_by_turn":{"$ref":"#/$defs/curve"}}},
    "delta":{"type":"object","additionalProperties":false,"required":["value","ci95"],"properties":{"value":{"type":"number","minimum":-1,"maximum":1},"ci95":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}}}},
    "fasteffect":{"type":"object","additionalProperties":false,"required":["paired_cast_probability_delta_by_turn","mean_turn_acceleration_when_both_cast","interpretation"],"properties":{"paired_cast_probability_delta_by_turn":{"type":"object","additionalProperties":false,"required":["2","3","4","5","6"],"properties":{"2":{"$ref":"#/$defs/delta"},"3":{"$ref":"#/$defs/delta"},"4":{"$ref":"#/$defs/delta"},"5":{"$ref":"#/$defs/delta"},"6":{"$ref":"#/$defs/delta"}}},"mean_turn_acceleration_when_both_cast":{"type":"object","additionalProperties":false,"required":["value","ci95","paired_games"],"properties":{"value":{"type":["number","null"]},"ci95":{"type":"array","minItems":2,"maxItems":2,"items":{"type":["number","null"]}},"paired_games":{"type":"integer","minimum":0}}},"interpretation":{"type":"string"}}},
    "recovery":{"type":"object","additionalProperties":false,"required":["removal_event_share","recast_share_given_removal","recast_within_turns_given_removal","recovery_turns_mean_when_recast","event_count","recast_count"],"properties":{"removal_event_share":{"$ref":"#/$defs/prob"},"recast_share_given_removal":{"$ref":"#/$defs/prob"},"recast_within_turns_given_removal":{"type":"object","additionalProperties":false,"required":["1","2","3"],"properties":{"1":{"$ref":"#/$defs/prob"},"2":{"$ref":"#/$defs/prob"},"3":{"$ref":"#/$defs/prob"}}},"recovery_turns_mean_when_recast":{"type":"object","additionalProperties":false,"required":["value","ci95"],"properties":{"value":{"type":["number","null"]},"ci95":{"type":"array","minItems":2,"maxItems":2,"items":{"type":["number","null"]}}}},"event_count":{"type":"integer","minimum":0},"recast_count":{"type":"integer","minimum":0}}},
    "staticcost":{"type":["object","null"]},
    "commander":{"type":"object","additionalProperties":false,"required":["commander","static_cost","fast_mana_inventory","baseline","no_fast_mana_counterfactual","fast_mana_contribution","tax_recovery_after_one_removal","tax_recovery_after_two_removals"],"properties":{"commander":{"type":"string"},"static_cost":{"$ref":"#/$defs/staticcost"},"fast_mana_inventory":{"type":"array","items":{"type":"string"}},"baseline":{"$ref":"#/$defs/castsummary"},"no_fast_mana_counterfactual":{"$ref":"#/$defs/castsummary"},"fast_mana_contribution":{"$ref":"#/$defs/fasteffect"},"tax_recovery_after_one_removal":{"$ref":"#/$defs/recovery"},"tax_recovery_after_two_removals":{"type":"object","additionalProperties":false,"required":["first","second"],"properties":{"first":{"$ref":"#/$defs/recovery"},"second":{"$ref":"#/$defs/recovery"}}}}}
  }
}
