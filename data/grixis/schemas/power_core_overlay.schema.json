{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/corymstover/GrokBotMTGCompanion/data/grixis/schemas/power_core_overlay.schema.json",
  "title": "Post-M2 power_core correction overlay v1",
  "description": "Versioned D5 overlay. It may flag commander-independent power packages for review without rewriting accepted M2 Blueprints. Any future proposed change to material Blueprint fields is gated and requires targeted M2 review/reopen.",
  "type": "object",
  "required": ["schema_version", "deck_id", "slug", "canonical_hash", "blueprint_version", "status", "authority", "materiality_policy", "candidates", "summary"],
  "properties": {
    "schema_version": {"const": 1},
    "deck_id": {"$ref": "common.schema.json#/$defs/deck_id"},
    "slug": {"$ref": "common.schema.json#/$defs/slug"},
    "canonical_hash": {"$ref": "common.schema.json#/$defs/list_hash"},
    "blueprint_version": {"type": "integer", "minimum": 1},
    "status": {"const": "provisional_overlay"},
    "authority": {
      "type": "object",
      "required": ["can_rewrite_blueprint", "can_reopen_m2", "can_decide_deck"],
      "properties": {
        "can_rewrite_blueprint": {"const": false},
        "can_reopen_m2": {"const": false},
        "can_decide_deck": {"const": false}
      },
      "additionalProperties": false
    },
    "materiality_policy": {
      "type": "object",
      "required": ["material_fields", "rule"],
      "properties": {
        "material_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "rule": {"type": "string"}
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["combo_id", "cards", "classification", "compactness", "blueprint_win_linked", "commander_independent", "why_flagged", "evidence_class", "confidence", "evidence", "materiality"],
        "properties": {
          "combo_id": {"type": "string"},
          "cards": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "classification": {"const": "power_core_review_candidate"},
          "compactness": {"enum": ["compact_2", "compact_3", "extended_4_plus"]},
          "blueprint_win_linked": {"type": "boolean"},
          "commander_independent": {"type": "boolean"},
          "why_flagged": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evidence_class": {"const": "heuristic"},
          "confidence": {"enum": ["moderate", "low"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/evidence_ref"}},
          "materiality": {
            "type": "object",
            "required": ["current_overlay_changes_blueprint", "proposed_blueprint_changes", "material_fields_touched", "m2_action"],
            "properties": {
              "current_overlay_changes_blueprint": {"const": false},
              "proposed_blueprint_changes": {"type": "array", "maxItems": 0},
              "material_fields_touched": {"type": "array", "maxItems": 0},
              "m2_action": {"const": "no_reopen_for_overlay_only; targeted review required before any material application"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["candidate_count", "compact_candidate_count", "material_blueprint_changes_proposed", "m2_reopen_requested"],
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 0},
        "compact_candidate_count": {"type": "integer", "minimum": 0},
        "material_blueprint_changes_proposed": {"const": 0},
        "m2_reopen_requested": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
