{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/corymstover/GrokBotMTGCompanion/data/grixis/schemas/m6_phase_b_plan.schema.json",
  "title": "M6 preregistered candidate Phase-B investigation, not execution",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "stage": {
      "const": "M6_Phase_B_preregistered_plan"
    },
    "date": {
      "type": "string",
      "minLength": 1
    },
    "deck_id": {
      "$ref": "common.schema.json#/$defs/deck_id"
    },
    "slug": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "base_hash": {
      "$ref": "common.schema.json#/$defs/list_hash"
    },
    "accepted_m5_snapshot": {
      "type": "string",
      "minLength": 1
    },
    "preregistered_before_new_tests": {
      "const": true
    },
    "identity_guard": {
      "type": "string",
      "minLength": 1
    },
    "controls": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "candidate": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "minLength": 1
          },
          "swap_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "model_requirements": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "test_status": {
            "const": "not_executed"
          },
          "agent_judgment": {
            "const": "pending"
          }
        },
        "required": [
          "candidate",
          "priority",
          "swap_ids",
          "model_requirements",
          "test_status",
          "agent_judgment"
        ],
        "additionalProperties": false
      }
    },
    "required_before_determination": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "const": "preregistered_not_executed"
    },
    "counts": {
      "type": "object",
      "properties": {
        "candidate_groups": {
          "type": "integer",
          "minimum": 1
        },
        "hypotheses": {
          "type": "integer",
          "minimum": 1
        },
        "phase_b_tests_completed": {
          "const": 0
        },
        "formal_judgments_completed": {
          "const": 0
        },
        "swaps_applied": {
          "const": 0
        }
      },
      "required": [
        "candidate_groups",
        "hypotheses",
        "phase_b_tests_completed",
        "formal_judgments_completed",
        "swaps_applied"
      ],
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "properties": {
        "can_decide": {
          "const": false
        },
        "can_apply_swap": {
          "const": false
        },
        "can_change_canonical_list": {
          "const": false
        },
        "can_approve_or_lock": {
          "const": false
        }
      },
      "required": [
        "can_decide",
        "can_apply_swap",
        "can_change_canonical_list",
        "can_approve_or_lock"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "stage",
    "date",
    "deck_id",
    "slug",
    "base_hash",
    "accepted_m5_snapshot",
    "preregistered_before_new_tests",
    "identity_guard",
    "controls",
    "groups",
    "required_before_determination",
    "status",
    "counts",
    "authority"
  ],
  "additionalProperties": false
}
