{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/corymstover/GrokBotMTGCompanion/data/grixis/schemas/combo_quality.schema.json",
  "title": "Grixis Combo Quality Model v1",
  "description": "Descriptive combo-quality evidence. Spellbook establishes combo facts; blueprint/graph data add deck-specific context. Unknown timing/zones/colored mana are recorded as unknown or deferred, never guessed. No field approves a combo or deck.",
  "type": "object",
  "required": ["schema_version", "deck_id", "slug", "canonical_hash", "generated_by", "status", "authority", "inputs", "combos", "summary"],
  "properties": {
    "schema_version": {"const": 1},
    "deck_id": {"$ref": "common.schema.json#/$defs/deck_id"},
    "slug": {"$ref": "common.schema.json#/$defs/slug"},
    "canonical_hash": {"$ref": "common.schema.json#/$defs/list_hash"},
    "generated_by": {"type": "string"},
    "status": {"const": "provisional_evidence"},
    "authority": {
      "type": "object",
      "required": ["exploratory", "can_decide", "note"],
      "properties": {
        "exploratory": {"const": true},
        "can_decide": {"const": false},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "required": ["spellbook", "blueprint", "graph", "registry"],
      "properties": {
        "spellbook": {"type": "string"},
        "blueprint": {"type": "string"},
        "graph": {"type": "string"},
        "registry": {"type": "string"}
      },
      "additionalProperties": false
    },
    "combos": {
      "type": "array",
      "items": {"$ref": "#/$defs/combo"}
    },
    "summary": {
      "type": "object",
      "required": ["combo_count", "infinite_count", "commander_piece_count", "blueprint_win_linked_count", "commander_independent_win_hint_count", "unresolved_classification_count"],
      "properties": {
        "combo_count": {"type": "integer", "minimum": 0},
        "infinite_count": {"type": "integer", "minimum": 0},
        "commander_piece_count": {"type": "integer", "minimum": 0},
        "blueprint_win_linked_count": {"type": "integer", "minimum": 0},
        "commander_independent_win_hint_count": {"type": "integer", "minimum": 0},
        "unresolved_classification_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "axis": {
      "type": "object",
      "required": ["value", "evidence_class", "confidence", "evidence"],
      "properties": {
        "value": {},
        "evidence_class": {"$ref": "common.schema.json#/$defs/evidence_class"},
        "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "common.schema.json#/$defs/evidence_ref"}
        },
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "piece": {
      "type": "object",
      "required": ["name", "graph_present", "mv", "type_line", "roles", "packages", "identity_core", "tutor_target", "recursion", "independent_signal_count"],
      "properties": {
        "name": {"type": "string"},
        "graph_present": {"type": "boolean"},
        "mv": {"type": ["number", "null"]},
        "type_line": {"type": ["string", "null"]},
        "roles": {"type": "array", "items": {"type": "string"}},
        "packages": {"type": "array", "items": {"type": "string"}},
        "identity_core": {"type": "boolean"},
        "tutor_target": {"type": "boolean"},
        "recursion": {"type": "boolean"},
        "independent_signal_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "required": ["structural_hint", "outcome_hint", "priority", "status", "evidence_class", "confidence", "evidence"],
      "properties": {
        "structural_hint": {
          "enum": ["commander_native_combo", "commander_supported_combo", "commander_independent_power_package", "unlinked_spellbook_combo"]
        },
        "outcome_hint": {
          "enum": ["blueprint_designated_win_line", "blueprint_win_requires_external_payoff", "incidental_infinite_or_value_loop_requires_judgment", "noninfinite_combo_requires_judgment"]
        },
        "priority": {"const": "unresolved_requires_judgment"},
        "status": {"const": "provisional_hint_not_decision"},
        "evidence_class": {"const": "heuristic"},
        "confidence": {"enum": ["moderate", "low", "test_required"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/evidence_ref"}}
      },
      "additionalProperties": false
    },
    "combo": {
      "type": "object",
      "required": ["id", "cards", "spellbook", "piece_facts", "axes", "classification"],
      "properties": {
        "id": {"type": "string"},
        "cards": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "spellbook": {
          "type": "object",
          "required": ["infinite", "produces", "requires", "csb_bracket_tag", "evidence_class", "confidence", "evidence"],
          "properties": {
            "infinite": {"type": "boolean"},
            "produces": {"type": "array", "items": {"type": "string"}},
            "requires": {"type": "array", "items": {}},
            "csb_bracket_tag": {"type": ["string", "null"]},
            "evidence_class": {"const": "fact"},
            "confidence": {"const": "verified"},
            "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/evidence_ref"}}
          },
          "additionalProperties": false
        },
        "piece_facts": {"type": "array", "items": {"$ref": "#/$defs/piece"}},
        "axes": {
          "type": "object",
          "required": ["card_count", "mana", "zones", "commander_requirement", "setup", "timing", "interaction_windows", "tutor_accessibility", "redundancy", "dead_card_burden", "resilience", "recovery", "immediate_win", "required_payoff", "independent_usefulness", "commander_contribution"],
          "properties": {
            "card_count": {"$ref": "#/$defs/axis"},
            "mana": {"$ref": "#/$defs/axis"},
            "zones": {"$ref": "#/$defs/axis"},
            "commander_requirement": {"$ref": "#/$defs/axis"},
            "setup": {"$ref": "#/$defs/axis"},
            "timing": {"$ref": "#/$defs/axis"},
            "interaction_windows": {"$ref": "#/$defs/axis"},
            "tutor_accessibility": {"$ref": "#/$defs/axis"},
            "redundancy": {"$ref": "#/$defs/axis"},
            "dead_card_burden": {"$ref": "#/$defs/axis"},
            "resilience": {"$ref": "#/$defs/axis"},
            "recovery": {"$ref": "#/$defs/axis"},
            "immediate_win": {"$ref": "#/$defs/axis"},
            "required_payoff": {"$ref": "#/$defs/axis"},
            "independent_usefulness": {"$ref": "#/$defs/axis"},
            "commander_contribution": {"$ref": "#/$defs/axis"}
          },
          "additionalProperties": false
        },
        "classification": {"$ref": "#/$defs/classification"}
      },
      "additionalProperties": false
    }
  }
}
